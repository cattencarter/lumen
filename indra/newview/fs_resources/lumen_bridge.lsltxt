//
// WHY THIS EXISTS AND WHAT IT IS NOT
//
// A handful of things Second Life tells a SCRIPT and will not tell a viewer:
// who created an object, what somebody else is wearing, how much land impact a
// thing costs, how high an avatar is when they are above the region's own
// reporting ceiling. The viewer can get the creator only by SELECTING an
// object, which draws a beam other people can see. llGetObjectDetails answers
// silently, for any key.
//
// This implements the SAME COMMAND SET as Firestorm's bridge, because Lumen is
// built on Firestorm and ten of its files call into it -- Area Search, the
// radar's altitudes, flight assist, movelock, the RLV attachment rules and the
// inventory protections all speak this protocol. A viewer carrying our own
// bridge and not theirs must answer everything theirs did, or those features
// go quiet with nothing saying why.
//
// **It is written fresh rather than copied.** A command vocabulary is an
// interface; their script is an unmarked file whose licence could not be
// established from the distribution it ships in. Writing it removes the
// question rather than arguing it.
//
// Two commands are ours and have no counterpart there: `worn` and `object`.
// `worn` is the reason any of this was worth doing -- llGetAttachedList gives
// a whole avatar in ONE round trip, where getScriptInfo takes one object at a
// time and asking what somebody is wearing would be twenty-five requests
// through an in-world script.

string  VERSION = "1.0";
string  gURL;
key     gOwner;
integer gViewerIsLumen;
integer gTryHandshakeOnce = TRUE;

// Teleport assist (OpenSim only; Second Life refuses it and the viewer says so)
float   TP_TARGET_DISTANCE = 1.0;
integer MAX_TIME_TO_TP     = 10;
float   TP_TIMER_TICK      = 0.05;
vector  gMttVector;
integer gStartTPTimer;

// Movelock
integer gUseMoveLock;
integer gRelockAfterMovement;
integer gRelockIsUserMoving;

// Flight assist
integer gIsFlyingNow;
float   FLIGHT_CHECK_NORMAL = 0.5;
float   FLIGHT_CHECK_SLOW   = 3.0;
float   gFlightPushForce;

// OpenCollar / LockMeister AO interface
integer gAO_OpenCollar;
integer gAO_LockMeister;
integer gAO_ChannelOC;
integer AO_CHANNEL_LM = -8888;
integer gAO_ListenOC;
integer gAO_ListenLM;
key     gAO_CollarKey;

// ---------------------------------------------------------------- helpers

// Anything a person wrote goes out as base64. Object names in Second Life
// contain commas, quotes and newlines, and a decade of them predate anyone
// caring -- Decisions 28, which already killed one notecard search at card
// 356 of 3,691.
string pack(string s) { return llStringToBase64(s); }

getURL()
{
    llReleaseURL(gURL);
    gURL = "";
    llRequestSecureURL();
}

detachSelf()
{
    llReleaseURL(gURL);
    llRequestPermissions(gOwner, PERMISSION_ATTACH);
}

aoState(string s) { llOwnerSay("<clientAO state=" + s + ">"); }

aoListenOC(key collar, integer on)
{
    llListenRemove(gAO_ListenOC);
    if (on) { gAO_ListenOC = llListen(gAO_ChannelOC, "", collar, ""); gAO_CollarKey = collar; }
    else    { gAO_CollarKey = NULL_KEY; }
}

checkOC()
{
    if (gAO_OpenCollar && gAO_ChannelOC != PUBLIC_CHANNEL)
    {
        aoListenOC(NULL_KEY, TRUE);
        llWhisper(gAO_ChannelOC, "OpenCollar?");
    }
    else aoListenOC(NULL_KEY, FALSE);
}

checkLM()
{
    if (gAO_LockMeister) gAO_ListenLM = llListen(AO_CHANNEL_LM, "", NULL_KEY, "");
    else                 llListenRemove(gAO_ListenLM);
}

// A second timer. llSetTimerEvent is spoken for by flight assist, and a
// sensor that can never match is the cheapest repeating event LSL has.
setTimer2(float t)
{
    if (t <= 0) llSensorRemove();
    else llSensorRepeat("lumen-timer-2", NULL_KEY, AGENT_BY_LEGACY_NAME, 0.001, 0.001, t);
}

flightHover(integer on)
{
    if (on) llSetForce((<0.0, 0.0, 9.8> * llGetMass()), 0);
    else    llSetForce(ZERO_VECTOR, 1);
}

// Holding an avatar still is not a single call. Moving to a point just below
// where you already are keeps the physics engine pushing back, and the sled
// with almost no friction timescale stops it drifting. Both halves are needed.
movelock(integer lock)
{
    if (lock)
    {
        llMoveToTarget(llGetPos() - <0, 0, 0.1>, 0.05);
        llSetVehicleType(VEHICLE_TYPE_SLED);
        llSetVehicleFloatParam(VEHICLE_LINEAR_FRICTION_TIMESCALE, 0.05);
        llSetVehicleFloatParam(VEHICLE_ANGULAR_FRICTION_TIMESCALE, 0.05);
    }
    else
    {
        llStopMoveToTarget();
        llSetVehicleType(VEHICLE_TYPE_NONE);
    }
}

// ---- our own: what one object is, for `worn` and `object` ----------------
string describe(key id)
{
    list d = llGetObjectDetails(id, [OBJECT_NAME, OBJECT_DESC, OBJECT_CREATOR,
                                     OBJECT_OWNER, OBJECT_ATTACHED_POINT,
                                     OBJECT_PRIM_EQUIVALENCE, OBJECT_TOTAL_SCRIPT_COUNT,
                                     OBJECT_CREATION_TIME]);
    if (llGetListLength(d) != 8) return "";
    return (string)id + ","
         + pack(llList2String(d, 0)) + ","
         + pack(llList2String(d, 1)) + ","
         + (string)llList2Key(d, 2) + ","
         + (string)llList2Key(d, 3) + ","
         + (string)llList2Integer(d, 4) + ","
         + (string)llList2Integer(d, 5) + ","
         + (string)llList2Integer(d, 6) + ","
         + pack(llList2String(d, 7));
}

// ---- the viewer's script-info panel expects EXACTLY this shape ------------
// 6 fields plain, 27 extended, base64 at 0, 6, 11, 12, 13, 14 and 25.
// BASE64-FIELDS: 0,6,11,12,13,14,25
// (scripts/bridge-check.py compares that line against the viewer's parser, so
//  an upstream merge that reorders the fields fails a check instead of filling
//  the panel with mojibake.)
// fslslbridge.cpp decodes those positions by number, so the order is a
// contract and not a preference.
scriptInfo(key target, integer extended)
{
    vector here = llGetPos();
    list d;
    integer want;

    if (extended)
    {
        d = llGetObjectDetails(target, [OBJECT_NAME, OBJECT_RUNNING_SCRIPT_COUNT,
            OBJECT_TOTAL_SCRIPT_COUNT, OBJECT_SCRIPT_MEMORY, OBJECT_SCRIPT_TIME,
            OBJECT_CHARACTER_TIME, OBJECT_DESC, OBJECT_ROOT, OBJECT_PRIM_COUNT,
            OBJECT_PRIM_EQUIVALENCE, OBJECT_TOTAL_INVENTORY_COUNT, OBJECT_VELOCITY,
            OBJECT_POS, OBJECT_ROT, OBJECT_OMEGA, OBJECT_CREATOR, OBJECT_OWNER,
            OBJECT_LAST_OWNER_ID, OBJECT_REZZER_KEY, OBJECT_GROUP, OBJECT_CREATION_TIME,
            OBJECT_REZ_TIME, OBJECT_PATHFINDING_TYPE, OBJECT_ATTACHED_POINT,
            OBJECT_TEMP_ATTACHED]);
        d = d + [here, target];
        want = 27;
    }
    else
    {
        d = llGetObjectDetails(target, [OBJECT_NAME, OBJECT_RUNNING_SCRIPT_COUNT,
            OBJECT_TOTAL_SCRIPT_COUNT, OBJECT_SCRIPT_MEMORY, OBJECT_SCRIPT_TIME,
            OBJECT_CHARACTER_TIME]);
        want = 6;
    }

    if (llGetListLength(d) != want)
    {
        llOwnerSay("<bridgeError error=scriptinfonotfound>");
        return;
    }

    list out = [pack(llStringTrim(llList2String(d, 0), STRING_TRIM)),
                llList2String(d, 1), llList2String(d, 2),
                llList2Integer(d, 3) / 1024,
                llList2Float(d, 4) * 1000.0,
                llList2Float(d, 5) * 1000.0];

    if (extended)
    {
        out += [pack(llStringTrim(llList2String(d, 6), STRING_TRIM)),
                llList2String(d, 7), llList2Integer(d, 8), llList2Integer(d, 9),
                llList2Integer(d, 10),
                pack(llList2String(d, 11)),
                pack(llList2String(d, 12) + " (" + (string)llVecDist(llList2Vector(d, 12), here) + " m)"),
                pack(llList2String(d, 13) + " (" + (string)(RAD_TO_DEG * llRot2Euler(llList2Rot(d, 13))) + ")"),
                pack(llList2String(d, 14)),
                llList2Key(d, 15), llList2Key(d, 16), llList2Key(d, 17), llList2Key(d, 18),
                llList2Key(d, 19), llList2String(d, 20), llList2String(d, 21),
                llList2Integer(d, 22), llList2Integer(d, 23), llList2Integer(d, 24),
                pack(llList2String(d, 25)), llList2Key(d, 26)];
    }

    llOwnerSay("<bridgeGetScriptInfo>" + llList2CSV(out) + "</bridgeGetScriptInfo>");
}

// ------------------------------------------------------------------- main

default
{
    on_rez(integer p)
    {
        // Never leave litter if this is ever rezzed rather than worn.
        llSetLinkPrimitiveParamsFast(LINK_THIS, [PRIM_TEMP_ON_REZ, TRUE]);
    }

    attach(key k)
    {
        if (!k) return;

        gOwner = llGetOwner();
        // Controls are taken for one reason only: flight assist and movelock
        // need to know when the user is pressing a movement key. Taking them
        // with pass-through also makes the script work on no-script parcels.
        llRequestPermissions(gOwner, PERMISSION_TAKE_CONTROLS);

        gUseMoveLock    = FALSE;
        gFlightPushForce = 0.0;
        gIsFlyingNow    = -1;
        gAO_OpenCollar  = FALSE;
        gAO_LockMeister = FALSE;

        setTimer2(0);
        llSetTimerEvent(0);
        flightHover(FALSE);
        movelock(FALSE);

        if (llGetMemoryLimit() <= 16384) llOwnerSay("<bridgeError error=wrongvm>");

        gAO_ChannelOC = (integer)("0x" + llGetSubString(gOwner, 30, -1));
        if (gAO_ChannelOC > 0) gAO_ChannelOC = -gAO_ChannelOC;
        checkOC();
        checkLM();

        gTryHandshakeOnce = TRUE;
        gViewerIsLumen    = FALSE;
        getURL();
    }

    run_time_permissions(integer p)
    {
        if (p & PERMISSION_TAKE_CONTROLS)
        {
            llTakeControls(CONTROL_FWD | CONTROL_BACK | CONTROL_LEFT | CONTROL_RIGHT
                         | CONTROL_UP | CONTROL_DOWN, TRUE, TRUE);
        }
        else if (p & PERMISSION_ATTACH) llDetachFromAvatar();
    }

    control(key id, integer level, integer edge)
    {
        if (gUseMoveLock && gRelockAfterMovement)
        {
            if (level & (CONTROL_FWD|CONTROL_BACK|CONTROL_LEFT|CONTROL_RIGHT|CONTROL_UP|CONTROL_DOWN))
            {
                if (!gRelockIsUserMoving) { gRelockIsUserMoving = TRUE; movelock(FALSE); }
            }
            else if (gRelockIsUserMoving) { gRelockIsUserMoving = FALSE; movelock(TRUE); }
        }

        if (gFlightPushForce > 0 && gIsFlyingNow)
        {
            if (level & edge & (CONTROL_FWD|CONTROL_BACK|CONTROL_LEFT|CONTROL_RIGHT|CONTROL_UP|CONTROL_DOWN))
            {
                vector push = ZERO_VECTOR;
                if      (level & CONTROL_FWD)   push += <gFlightPushForce, 0, 0>;
                else if (level & CONTROL_BACK)  push += <-gFlightPushForce, 0, 0>;
                if      (level & CONTROL_LEFT)  push += <0, gFlightPushForce, 0>;
                else if (level & CONTROL_RIGHT) push += <0, -gFlightPushForce, 0>;
                if      (level & CONTROL_UP)    push += <0, 0, gFlightPushForce>;
                else if (level & CONTROL_DOWN)  push += <0, 0, -gFlightPushForce>;
                llSetForce(llGetMassMKS() * push, 1);
            }
            else if (~level & edge & (CONTROL_FWD|CONTROL_BACK|CONTROL_LEFT|CONTROL_RIGHT|CONTROL_UP|CONTROL_DOWN))
            {
                flightHover(TRUE);
            }
        }
    }

    changed(integer c)
    {
        // A URL does not survive a region crossing. This is the one piece of
        // lifecycle that cannot be skipped.
        if (c & CHANGED_REGION) getURL();
        else if (c & (CHANGED_INVENTORY | CHANGED_ALLOWED_DROP))
        {
            // Resist anything dropped in here that wants to run. An attachment
            // the viewer creates and wears is a tempting place to hide a
            // script, and it is worn by somebody who never chose its contents.
            string me = llGetScriptName();
            integer n = llGetInventoryNumber(INVENTORY_SCRIPT);
            if (n > 1)
            {
                llOwnerSay("<bridgeError error=injection>");
                llSleep(1.0);
                while (n)
                {
                    string s = llGetInventoryName(INVENTORY_SCRIPT, --n);
                    if (s != me) llSetScriptState(s, FALSE);
                }
            }
            llParticleSystem([]);
            llSetTextureAnim(FALSE, ALL_SIDES, 1, 1, 1.0, 1.0, 1.0);
            llAllowInventoryDrop(FALSE);
            llSetTorque(ZERO_VECTOR, 0);
            flightHover(FALSE);
            gIsFlyingNow = -1;
            movelock(gUseMoveLock);
        }
        else if (c & CHANGED_OWNER) llResetScript();
    }

    timer()
    {
        if (llGetAgentInfo(gOwner) & AGENT_FLYING)
        {
            if (gIsFlyingNow != TRUE)
            {
                gIsFlyingNow = TRUE; flightHover(TRUE); llSetTimerEvent(FLIGHT_CHECK_NORMAL);
            }
        }
        else if (gIsFlyingNow != FALSE)
        {
            gIsFlyingNow = FALSE; flightHover(FALSE); llSetTimerEvent(FLIGHT_CHECK_SLOW);
        }
    }

    no_sensor()
    {
        vector loc  = llGetPos();
        vector targ = gMttVector - loc;
        float  dist = llVecMag(targ);

        if (dist < TP_TARGET_DISTANCE
            || llGetUnixTime() - MAX_TIME_TO_TP > gStartTPTimer
            || gMttVector == loc)
        {
            setTimer2(0);
            movelock(gUseMoveLock);
        }
        else if (dist < 65) llMoveToTarget(gMttVector, TP_TIMER_TICK);
        else                llMoveToTarget(loc + llVecNorm(targ) * 60, TP_TIMER_TICK);
    }

    http_request(key req, string method, string body)
    {
        if (method == URL_REQUEST_GRANTED)
        {
            gURL = body;
            if (gViewerIsLumen || gTryHandshakeOnce)
            {
                // BRIDGEKEY is replaced with this bridge's inventory folder id
                // by the viewer before upload (fslslbridge.cpp:1376). It is how
                // the viewer knows the announcement came from the bridge it
                // made, and not from a copy somebody else is wearing.
                llOwnerSay("<bridgeURL>" + gURL + "</bridgeURL><bridgeAuth>BRIDGEKEY</bridgeAuth><bridgeVer>" + VERSION + "</bridgeVer>");
                gTryHandshakeOnce = FALSE;
            }
            else
            {
                // Wrong viewer: it never confirmed. Leave quietly rather than
                // hanging on somebody who did not ask for us.
                detachSelf();
            }
            return;
        }
        if (method == URL_REQUEST_DENIED)
        {
            llOwnerSay("<bridgeRequestError/>");
            llSleep(5.0);
            getURL();
            return;
        }
        if (method != "POST" && method != "GET") return;

        list args = llParseString2List(llGetSubString(body, 14, llStringLength(body) - 18), ["|"], []);
        string cmd = llList2String(args, 0);

        // ---- ours -------------------------------------------------------
        if (cmd == "worn")
        {
            key target = (key)llList2String(args, 1);
            list ids = llGetAttachedList(target);
            string out = (string)llList2Integer(llGetObjectDetails(target,
                            [OBJECT_ATTACHED_SLOTS_AVAILABLE]), 0) + "\n";
            integer n = llGetListLength(ids);
            integer i;
            for (i = 0; i < n; ++i)
            {
                string one = describe(llList2Key(ids, i));
                if (one != "") out += one + "\n";
            }
            llHTTPResponse(req, 200, "<llsd><string>" + out + "</string></llsd>");
            return;
        }
        else if (cmd == "object")
        {
            llHTTPResponse(req, 200, "<llsd><string>" + describe((key)llList2String(args, 1)) + "</string></llsd>");
            return;
        }

        // ---- the ones the rest of the viewer already depends on ----------
        else if (cmd == "getZOffsets")
        {
            // The radar's altitudes. A region stops reporting a position above
            // 1023 metres, so anything higher is invisible to the viewer and
            // only a script can see it.
            list ids = llCSV2List(llList2String(args, 1));
            args = [];
            integer n = llGetListLength(ids);
            list out;
            integer i;
            for (i = 0; i < n; ++i)
            {
                key k = (key)llList2String(ids, i);
                vector p = llList2Vector(llGetObjectDetails(k, [OBJECT_POS]), 0);
                if (p.z > 1023) out = out + k + p.z;
            }
            ids = [];
            llHTTPResponse(req, 200, "<llsd><string>" + llList2CSV(out) + "</string></llsd>");
            return;
        }
        else if (cmd == "getScriptInfo")
        {
            scriptInfo((key)llList2String(args, 1), llList2Integer(args, 2));
        }
        else if (cmd == "UseMoveLock")
        {
            gUseMoveLock = llList2Integer(args, 1);
            movelock(gUseMoveLock);
            if (llList2String(args, 2) != "noreport")
                llOwnerSay("<bridgeMovelock state=" + (string)gUseMoveLock + ">");
        }
        else if (cmd == "RelockMoveLockAfterMovement")
        {
            gRelockAfterMovement = llList2Integer(args, 1);
        }
        else if (cmd == "UseLSLFlightAssist")
        {
            float speed = llList2Float(args, 1);
            if (speed != gFlightPushForce)
            {
                gFlightPushForce = speed;
                if (gFlightPushForce > 0)
                {
                    if (gFlightPushForce > 15.0) gFlightPushForce = 15.0;   // no lightspeed
                    llSetTimerEvent(FLIGHT_CHECK_NORMAL);
                }
                else { llSetTimerEvent(0); flightHover(FALSE); }
            }
        }
        else if (cmd == "llMoveToTarget")
        {
            // Second Life does not allow this; the viewer passes a flag saying
            // which grid it is on and we simply agree.
            if (llList2String(args, 2) == "1")
            {
                llHTTPResponse(req, 200, "<llsd><string>ok</string></llsd>");
                return;
            }
            if (gUseMoveLock) movelock(FALSE);
            gMttVector = (vector)("<" + llList2String(args, 1) + ">");
            float ground = llGround(gMttVector - llGetPos());
            if (gMttVector.z < ground) gMttVector.z = ground + 1;   // not underground
            gStartTPTimer = llGetUnixTime();
            setTimer2(TP_TIMER_TICK);
        }
        else if (cmd == "ExternalIntegration")
        {
            integer oc = llList2Integer(args, 1);
            if (oc != gAO_OpenCollar)  { gAO_OpenCollar = oc;  checkOC(); }
            integer lm = llList2Integer(args, 2);
            if (lm != gAO_LockMeister) { gAO_LockMeister = lm; checkLM(); }
        }
        else if (cmd == "URL Confirmed")
        {
            gViewerIsLumen = TRUE;
        }
        else if (cmd == "DetachBridge")
        {
            detachSelf();
        }

        llHTTPResponse(req, 200, "<llsd><string>ok</string></llsd>");
    }

    listen(integer chan, string name, key id, string msg)
    {
        if (chan == gAO_ChannelOC)
        {
            integer z;
            if (gAO_CollarKey == NULL_KEY && msg == "OpenCollar=Yes") aoListenOC(id, TRUE);
            else if (msg == "OpenCollar=No") aoListenOC(NULL_KEY, TRUE);
            else if ((z = llSubStringIndex(msg, "ZHAO_")) >= 0)
            {
                z += 5;
                if      (llGetSubString(msg, z, z + 4) == "AOOFF")    aoState("off");
                else if (llGetSubString(msg, z, z + 3) == "AOON")     aoState("on");
                else if (llGetSubString(msg, z, z + 7) == "STANDOFF") aoState("standoff");
                else if (llGetSubString(msg, z, z + 6) == "STANDON")  aoState("standon");
            }
        }
        else if (chan == AO_CHANNEL_LM
                 && (key)llGetSubString(msg, 0, 35) == gOwner
                 && llList2Key(llGetObjectDetails(id, [OBJECT_ROOT]), 0) != gAO_CollarKey)
        {
            string c = llList2String(llParseStringKeepNulls(llGetSubString(msg, 36, -1), ["|"], []), 0);
            if      (c == "booton")  aoState("on");
            else if (c == "bootoff") aoState("off");
        }
    }
}
