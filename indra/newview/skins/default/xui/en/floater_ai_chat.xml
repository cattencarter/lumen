<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater
 legacy_header_height="18"
 can_minimize="true"
 can_close="true"
 can_resize="true"
 height="460"
 min_height="280"
 min_width="360"
 layout="topleft"
 name="floater_ai_chat"
 help_topic="floater_ai_chat"
 save_rect="true"
 single_instance="true"
 title="Assistant"
 width="440">

    <!-- Skills, in the title bar before the title: no room taken from the
         transcript or the chat bar (the author, 2026-10-07). -->
    <button
     follows="left|top"
     height="16"
     width="16"
     layout="topleft"
     left="4"
     top="1"
     name="skills_btn"
     image_unselected="Lumen_Skills_List"
     image_selected="Lumen_Skills_List"
     image_pressed="Lumen_Skills_List"
     image_hover_unselected="Lumen_Skills_List"
     image_hover_selected="Lumen_Skills_List"
     image_disabled="Lumen_Skills_List"
     image_disabled_selected="Lumen_Skills_List"
     label=""
     tab_stop="false"
     tool_tip="Skills: the routines you have taught, to run with a click" />

    <text_editor
     follows="all"
     height="352"
     layout="topleft"
     left="10"
     top="24"
     width="420"
     name="transcript"
     parse_urls="true"
     font="SansSerifSmall"
     max_length="262144"
     enabled="false"
     word_wrap="true"
     track_end="true"
     bg_readonly_color="TextBgReadOnlyColor"
     text_readonly_color="TextFgReadOnlyColor" />

    <!-- The action bar: one line saying what is happening right now, and when
         nothing is any more, what the turn cost. Nothing else lives here. It
         used to name the provider and model, which said the same thing for
         ever; that is written once at the top of the transcript instead. -->

    <text
     type="string"
     follows="left|right|bottom"
     height="18"
     layout="topleft"
     left="10"
     top="384"
     width="420"
     name="status" />

    <line_editor
     follows="left|right|bottom"
     height="22"
     layout="topleft"
     left="10"
     top="408"
     width="278"
     name="input"
     commit_on_focus_lost="false"
     label="Ask for something..." />
    <!-- <Lumen> Talk instead of typing. NOT voice chat: what is said here goes
         into the typing box above and nowhere else, and voice chat's own mic
         is closed while it listens. Hidden where there is no speech engine yet
         (lumenaispeech.h); the typing box then takes the room back.
         The toolbar's Speak icon, not Microphone_On: that one is drawn at 20%
         opacity throughout, so the button looked switched off while it worked. -->
    <button
     follows="right|bottom"
     height="22"
     layout="topleft"
     left="294"
     top="408"
     width="24"
     image_overlay="Command_Speak_Icon"
     is_toggle="true"
     name="mic_btn"
     tool_tip="Talk instead of typing. Pause, or click again, to stop. What you say goes to the assistant, not to voice chat." />

    <button
     follows="right|bottom"
     height="22"
     layout="topleft"
     left="324"
     top="408"
     width="76"
     label="Send"
     name="send_btn" />

    <!-- <Lumen> Clear is the bin icon rather than a word, so the typing box
         gets the room (the author, 2026-10-01). The same bin the viewer uses
         for removing things elsewhere; the tooltip carries the word. -->
    <button
     follows="right|bottom"
     height="22"
     layout="topleft"
     left="406"
     top="408"
     width="24"
     image_overlay="TrashItem_Off"
     name="clear_btn"
     tool_tip="Clear: start a new conversation. Also stops an answer that is still running." />

</floater>
