<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater
 legacy_header_height="18"
 can_minimize="true"
 can_close="true"
 can_resize="true"
 height="460"
 min_height="280"
 min_width="360"
 layout="topleft"
 name="floater_ai_chat"
 help_topic="floater_ai_chat"
 save_rect="true"
 single_instance="true"
 title="Assistant"
 width="440">

    <text_editor
     follows="all"
     height="352"
     layout="topleft"
     left="10"
     top="24"
     width="420"
     name="transcript"
     max_length="262144"
     enabled="false"
     word_wrap="true"
     track_end="true"
     bg_readonly_color="TextBgReadOnlyColor"
     text_readonly_color="TextFgReadOnlyColor" />

    <!-- The action bar: one line saying what is happening right now, and when
         nothing is any more, what the turn cost. Nothing else lives here. It
         used to name the provider and model, which said the same thing for
         ever; that is written once at the top of the transcript instead. -->

    <text
     type="string"
     follows="left|right|bottom"
     height="18"
     layout="topleft"
     left="10"
     top="384"
     width="420"
     name="status" />

    <line_editor
     follows="left|right|bottom"
     height="22"
     layout="topleft"
     left="10"
     top="408"
     width="248"
     name="input"
     commit_on_focus_lost="false"
     label="Ask for something..." />

    <button
     follows="right|bottom"
     height="22"
     layout="topleft"
     left="264"
     top="408"
     width="76"
     label="Send"
     name="send_btn" />

    <button
     follows="right|bottom"
     height="22"
     layout="topleft"
     left="346"
     top="408"
     width="84"
     label="Clear"
     name="clear_btn"
     tool_tip="Start a new conversation" />

</floater>
