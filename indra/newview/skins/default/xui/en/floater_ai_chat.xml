<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater
 legacy_header_height="18"
 can_minimize="true"
 can_close="true"
 can_resize="true"
 height="460"
 min_height="280"
 min_width="360"
 layout="topleft"
 name="floater_ai_chat"
 help_topic="floater_ai_chat"
 save_rect="true"
 single_instance="true"
 title="Assistant"
 width="440">

    <text_editor
     follows="all"
     height="360"
     layout="topleft"
     left="10"
     top="24"
     width="420"
     name="transcript"
     max_length="262144"
     enabled="false"
     word_wrap="true"
     track_end="true"
     bg_readonly_color="TextBgReadOnlyColor"
     text_readonly_color="TextFgReadOnlyColor" />

    <!-- Action bar. What used to sit here was a static line naming the
         provider and model, which told you the same thing for ever; that now
         goes at the top of the transcript once, where it reads as a fact about
         this conversation. The status text here is only for what is happening
         right now, so it is empty when nothing is. -->

    <button follows="left|bottom" layout="topleft"
     left="10" top="390" width="56" height="20"
     label="Clear" name="clear_btn" tool_tip="Start a new conversation" />

    <button follows="left|bottom" layout="topleft"
     left="70" top="390" width="66" height="20"
     label="Memory" name="memory_btn" tool_tip="What the assistant knows about you" />

    <button follows="left|bottom" layout="topleft"
     left="140" top="390" width="70" height="20"
     label="Settings" name="settings_btn" tool_tip="Keys, provider and model" />

    <text type="string" follows="right|bottom" layout="topleft"
     left="216" top="392" width="214" height="16"
     halign="right" name="status" />

    <line_editor follows="left|right|bottom" layout="topleft"
     left="10" top="416" width="358" height="22"
     name="input" commit_on_focus_lost="false"
     label="Ask for something..." />

    <button follows="right|bottom" layout="topleft"
     left="372" top="416" width="58" height="22"
     label="Send" name="send_btn" />

</floater>
