      <text type="string" follows="left|top" layout="topleft"
       left="20" top="364" width="370" height="28" word_wrap="true"
       name="speech_setup_text" visible="false">
          Speech recognition
      </text>

      <button follows="left|top" layout="topleft"
       left="400" top="366" width="110" height="22"
