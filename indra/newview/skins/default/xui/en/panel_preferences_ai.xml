      <check_box control_name="LumenAISpeechAutoSend" follows="left|top" layout="topleft"
       left="20" top="396" width="480" height="16"
       name="speech_auto_send"
       label="Send what I say as soon as I stop talking" />

      <check_box control_name="LumenAISpeechKeepListening" follows="left|top" layout="topleft"
       enabled_control="LumenAISpeechAutoSend"
       left="20" top="418" width="480" height="16"
       name="speech_keep_listening"
