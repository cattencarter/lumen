<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel
 border="true"
 follows="all"
 height="480"
 layout="topleft"
 left="1"
 top="1"
 width="540"
 label="AI"
 name="ai">

  <!-- Two tabs, because one flat panel stopped fitting once answering=while=away
       arrived. Structure copied from panel_preferences_privacy.xml rather than
       invented: Decisions 42 records that a widget dropped carelessly into a
       nested tab_container is how the login screen broke once already.
       The C++ side is unaffected — getChild and findChild search descendants,
       so every control is still found by the same name. -->

  <tab_container
   label="AI"
   layout="topleft"
   follows="all"
   top="5"
   bottom="-1"
   left="1"
   right="-1"
   name="tabs"
   tab_min_width="70"
   tab_position="top" >

    <!-- ============================ Providers ============================ -->
    <panel
     top_pad="5"
     bottom="-1"
     left="1"
     right="-1"
     follows="all"
     label="Providers"
     name="tab-providers" >

      <!-- The choice first, then only what that choice needs. Everything below
           lives in three panels at the same position; refresh() shows one. -->
      <text type="string" follows="left|top" layout="topleft"
       left="20" top="14" width="480" height="14" font="SansSerifBold">
          Use
      </text>

      <!-- <FS:AICtl> ONE Test button, beside the list rather than three
           differently named ones buried in three panels: "Check again" for
           Codex, "Check again" for Claude Code, "Test and warm up" for a local
           model, and nothing at all for the two that take an API key   which
           were the two where a wrong value is likeliest and silent.
           Hidden only for None, which has nothing to test. -->
      <button follows="left|top" layout="topleft" name="test_btn"
       left="332" top="32" width="80" height="22" label="Test" />

      <combo_box control_name="LumenAIProvider" follows="left|top" layout="topleft"
       left="20" top="32" width="300" height="22" name="provider">
          <combo_box.item label="None" name="none" value="none" />
          <combo_box.item label="Anthropic (API key)" name="anthropic" value="anthropic" />
          <combo_box.item label="OpenAI (API key)"    name="openai"    value="openai" />
          <combo_box.item label="Codex (your ChatGPT subscription)" name="codex" value="codex" />
          <combo_box.item label="Claude Code (your Claude subscription)" name="claudecode" value="claudecode" />
          <combo_box.item label="Local model" name="local" value="local" />
      </combo_box>

      <panel follows="left|top" layout="topleft" name="p_none"
       left="0" top="64" width="520" height="300" background_visible="false">

        <text type="string" follows="left|top" layout="topleft"
         left="20" top="4" width="480" height="60" word_wrap="true">
            The assistant is off. Lumen works as an ordinary Second Life viewer, and the Assistant window will tell you to come back here rather than trying to answer.
        </text>

        <text type="string" follows="left|top" layout="topleft"
         left="20" top="72" width="480" height="76" word_wrap="true">
            Pick one above when you want it. Codex and Claude Code use a subscription you may already pay for; Anthropic and OpenAI want an API key and bill you per message; a local model runs on this computer and sends nothing anywhere.
        </text>

      </panel>

      <!-- ============================ Anthropic ============================ -->
      <panel follows="left|top" layout="topleft" name="p_anthropic"
       left="0" top="64" width="520" height="300" background_visible="false">

        <text type="string" follows="left|top" layout="topleft"
         left="20" top="4" width="480" height="26" word_wrap="true">
            Get a key from Anthropic's own website and paste it here.
        </text>

        <line_editor follows="left|top" layout="topleft"
         left="20" top="36" width="330" height="22"
         name="key_anthropic" is_password="true" max_length_bytes="255" />

        <button follows="left|top" layout="topleft"
         left="358" top="36" width="70" height="22"
         label="Clear" name="clear_anthropic" />

        <text type="string" follows="left|top" layout="topleft"
         left="20" top="62" width="480" height="26" word_wrap="true"
         name="status_anthropic">
        </text>

        <text type="string" follows="left|top" layout="topleft"
         left="20" top="96" width="52" height="16">
            Model
        </text>

        <combo_box control_name="LumenAIAnthropicModel" follows="left|top" layout="topleft"
         left="76" top="92" width="274" height="22"
         name="model_anthropic" allow_text_entry="true" max_chars="80">
            <combo_box.item label="claude-haiku-4-5 (fastest, the default)" name="h45" value="claude-haiku-4-5-20251001" />
            <combo_box.item label="claude-sonnet-5 (balanced)"     name="s5" value="claude-sonnet-5" />
            <combo_box.item label="claude-opus-5 (most capable)"   name="o5" value="claude-opus-5" />
        </combo_box>

        <text type="string" follows="left|top" layout="topleft"
         left="20" top="124" width="480" height="26" word_wrap="true">
            You can type a model name that is not in the list. The list is a starting point, not a limit.
        </text>


        <text type="string" follows="left|top" layout="topleft"
         left="20" top="254" width="480" height="26" word_wrap="true">
            Keys are stored the same way as your Second Life password, and are no safer than one.
        </text>
      </panel>

      <!-- ============================= OpenAI ============================= -->
      <panel follows="left|top" layout="topleft" name="p_openai"
       left="0" top="64" width="520" height="300" background_visible="false">

        <text type="string" follows="left|top" layout="topleft"
         left="20" top="4" width="480" height="26" word_wrap="true">
            Get a key from OpenAI's own website and paste it here.
        </text>

        <line_editor follows="left|top" layout="topleft"
         left="20" top="36" width="330" height="22"
         name="key_openai" is_password="true" max_length_bytes="255" />

        <button follows="left|top" layout="topleft"
         left="358" top="36" width="70" height="22"
         label="Clear" name="clear_openai" />

        <text type="string" follows="left|top" layout="topleft"
         left="20" top="62" width="480" height="26" word_wrap="true"
         name="status_openai">
        </text>

        <text type="string" follows="left|top" layout="topleft"
         left="20" top="96" width="52" height="16">
            Model
        </text>

        <combo_box control_name="LumenAIOpenAIModel" follows="left|top" layout="topleft"
         left="76" top="92" width="274" height="22"
         name="model_openai" allow_text_entry="true" max_chars="80">
            <combo_box.item label="gpt-5.6-luna"  name="g56l" value="gpt-5.6-luna" />
            <combo_box.item label="gpt-5.6-sol"   name="g56s" value="gpt-5.6-sol" />
            <combo_box.item label="gpt-5.6-terra" name="g56t" value="gpt-5.6-terra" />
            <combo_box.item label="gpt-5.1"       name="g51"  value="gpt-5.1" />
            <combo_box.item label="gpt-5"         name="g5"   value="gpt-5" />
        </combo_box>

        <text type="string" follows="left|top" layout="topleft"
         left="20" top="124" width="480" height="26" word_wrap="true">
            You can type a model name that is not in the list. The list is a starting point, not a limit.
        </text>


        <text type="string" follows="left|top" layout="topleft"
         left="20" top="254" width="480" height="26" word_wrap="true">
            Keys are stored the same way as your Second Life password, and are no safer than one.
        </text>
      </panel>

      <panel follows="left|top" layout="topleft" name="p_claudecode"
       left="0" top="64" width="520" height="330" background_visible="false">

        <text type="string" follows="left|top" layout="topleft"
         left="20" top="4" width="480" height="40" word_wrap="true">
            Claude Code is Anthropic&apos;s own command-line tool. It signs in with your Claude account, so there is no API key and no separate bill.
        </text>

        <button follows="left|top" layout="topleft" name="claude_setup"
         left="165" top="44" width="190" height="24"
         label="Set it up for me..." />

        <text type="string" follows="left|top" layout="topleft" name="claude_status"
         left="20" top="80" width="480" height="92" word_wrap="true">
        </text>


        <!-- <FS:AICtl> Claude Code needs installing too, and its old advice was
             the WORSE of the two: `npm install -g`, which needs Node.js. The
             author asked the obvious question   "doesn't claude code require
             any kind of installation" and it does. Same guided window, and
             the native installer rather than npm. -->



        <text type="string" follows="left|top" layout="topleft"
         left="20" top="214" width="52" height="16">
            Model
        </text>

        <combo_box control_name="LumenAIClaudeCodeModel" follows="left|top" layout="topleft"
         left="76" top="210" width="274" height="22"
         name="model_claude" allow_text_entry="true" max_chars="80">
            <combo_box.item label="sonnet (balanced, the default here)" name="ks" value="sonnet" />
            <combo_box.item label="haiku (fastest)"                     name="kh" value="haiku" />
            <combo_box.item label="opus (most capable)"                 name="ko" value="opus" />
        </combo_box>

        <text type="string" follows="left|top" layout="topleft"
         left="20" top="242" width="480" height="54" word_wrap="true">
            These are Claude Code&apos;s own aliases, so each keeps meaning the newest model of that line. You can type a full model name instead. Changing the model starts a new conversation.
        </text>
      </panel>

      <panel follows="left|top" layout="topleft" name="p_local"
       left="0" top="64" width="520" height="330" background_visible="false">

        <text type="string" follows="left|top" layout="topleft"
         left="20" top="4" width="480" height="54" word_wrap="true">
            A model running on this computer. No key, no bill, and nothing leaves the machine. Start Ollama or LM Studio first; this is the address it serves on.
        </text>

        <line_editor follows="left|top" layout="topleft" control_name="LumenAILocalURL"
         left="20" top="64" width="480" height="22" name="url_local" max_length_bytes="255" />

        <text type="string" follows="left|top" layout="topleft"
         left="20" top="90" width="480" height="26" word_wrap="true">
            Ollama is http://localhost:11434/v1/chat/completions and LM Studio is http://localhost:1234/v1/chat/completions.
        </text>

        <text type="string" follows="left|top" layout="topleft"
         left="20" top="126" width="52" height="16">
            Model
        </text>

        <line_editor follows="left|top" layout="topleft" control_name="LumenAILocalModel"
         left="76" top="122" width="274" height="22" name="model_local" max_length_bytes="120" />

        <text type="string" follows="left|top" layout="topleft"
         left="20" top="150" width="480" height="58" word_wrap="true">
            Whatever name that server knows the model by. A small local model handles the viewer&apos;s own tools well. Writing scripts is different: a small one will often produce LSL that looks right, compiles, and quietly does the wrong thing. Use Anthropic or OpenAI for scripts.
        </text>


        <text type="string" follows="left|top" layout="topleft" name="local_status"
         left="20" top="244" width="480" height="54" word_wrap="true">
        </text>
      </panel>

      <!-- ============================== Codex ============================== -->
      <panel follows="left|top" layout="topleft" name="p_codex"
       left="0" top="64" width="520" height="330" background_visible="false">

        <text type="string" follows="left|top" layout="topleft"
         left="20" top="4" width="480" height="40" word_wrap="true">
            Codex is OpenAI's own command-line tool. It signs in with your ChatGPT account, so there is no API key and no separate bill.
        </text>

        <button follows="left|top" layout="topleft" name="codex_setup"
         left="165" top="44" width="190" height="24"
         label="Set it up for me..." />

        <text type="string" follows="left|top" layout="topleft" name="codex_status"
         left="20" top="80" width="480" height="96" word_wrap="true">
        </text>

        <!-- The command gets the WHOLE width and the buttons go underneath.
             Sharing a row with them clipped it: the field showed
             `curl -fsSL https://chatgpt.com/codex/install.sh |` with the
             trailing `sh` off the end, so anybody reading rather than clicking
             Copy would have run half a command and got a pipe waiting for
             input. Copy was always right; what was on screen was not. -->


        <!-- <FS:AICtl> The way in for somebody who has never opened Terminal.

             The copyable command and Check again stay, because they are the
             right tool for anybody who would rather see what runs. They are no
             longer the ONLY way, which is what the author objected to: those
             steps assume a reader who knows what a command line is, and the
             people this is for have only ever used the ChatGPT app. -->


        <text type="string" follows="left|top" layout="topleft"
         left="20" top="214" width="52" height="16">
            Model
        </text>

        <combo_box control_name="LumenAICodexModel" follows="left|top" layout="topleft"
         left="76" top="210" width="274" height="22"
         name="model_codex" allow_text_entry="true" max_chars="80">
            <combo_box.item label="gpt-5.6-luna" name="cl"  value="gpt-5.6-luna" />
            <combo_box.item label="gpt-5.6-sol"                     name="cs"  value="gpt-5.6-sol" />
            <combo_box.item label="gpt-5.6-terra (the default here)" name="ct"  value="gpt-5.6-terra" />
            <combo_box.item label="gpt-6-astra"                     name="ca"  value="gpt-6-astra" />
            <combo_box.item label="gpt-5.5"                         name="c55" value="gpt-5.5" />
        </combo_box>

        <text type="string" follows="left|top" layout="topleft"
         left="20" top="242" width="52" height="16">
            Thinking
        </text>

        <combo_box control_name="LumenAICodexEffort" follows="left|top" layout="topleft"
         left="76" top="238" width="274" height="22" name="effort_codex">
            <combo_box.item label="low -- fastest, and enough for most questions" name="el" value="low" />
            <combo_box.item label="medium"                                        name="em" value="medium" />
            <combo_box.item label="high"                                          name="eh" value="high" />
            <combo_box.item label="xhigh -- slowest, and the most of your allowance" name="ex" value="xhigh" />
        </combo_box>

        <text type="string" follows="left|top" layout="topleft"
         left="20" top="270" width="480" height="40" word_wrap="true">
            These are the models Codex offered when this list was written. Your ChatGPT plan decides which of them you can actually use, and you can type one that is not here. Changing the model starts a new conversation.
        </text>
      </panel>

    </panel>

    <!-- ============================ Assistant ============================ -->
    <panel
     top_pad="5"
     bottom="-1"
     left="1"
     right="-1"
     follows="all"
     label="Assistant"
     name="tab-assistant" >

      <!-- <FS:AICtl> There is no switch for the endpoint, here or anywhere.
           Lumen is a standalone viewer and nothing outside it may drive it.
           The socket still exists, because Codex and Claude Code are separate
           programs that reach the tools through it   but it listens only while
           one of those two is the chosen provider, on a port picked at random,
           and it is not a feature anybody is offered. -->
      <text type="string" follows="left|top" layout="topleft"
       left="20" top="14" width="480" height="14" font="SansSerifBold">
          Memory
      </text>

      <text type="string" follows="left|top" layout="topleft"
       left="20" top="34" width="480" height="26" word_wrap="true">
          What the assistant should already know about you, without being told each time.
      </text>

      <button follows="left|top" layout="topleft"
       left="20" top="66" width="140" height="22"
       label="Memory..." name="memory_btn" />

      <text type="string" follows="left|top" layout="topleft"
       left="20" top="106" width="480" height="14" font="SansSerifBold">
          While you are away
      </text>

      <text type="string" follows="left|top" layout="topleft"
       left="20" top="126" width="480" height="26" word_wrap="true">
          Ask the assistant: "answer my IMs until I get back". Tell it when you return and it stops.
      </text>

      <check_box control_name="LumenAIAutoRespondFriendsOnly" follows="left|top" layout="topleft"
       left="20" top="160" width="480" height="16"
       name="auto_respond_friends"
       label="Only answer people on my friends list" />

      <spinner control_name="LumenAIAutoRespondMinutes" follows="left|top" layout="topleft"
       left="20" top="184" width="200" height="20"
       name="auto_respond_minutes"
       label="Stop after" label_width="60"
       min_val="0" max_val="1440" increment="15" decimal_digits="0" />

      <text type="string" follows="left|top" layout="topleft"
       left="226" top="187" width="280" height="16">
          minutes (0 = no limit)
      </text>

      <spinner control_name="LumenAIAutoRespondMaxPerPerson" follows="left|top" layout="topleft"
       left="20" top="210" width="200" height="20"
       name="auto_respond_per_person"
       label="At most" label_width="60"
       min_val="1" max_val="50" increment="1" decimal_digits="0" />

      <text type="string" follows="left|top" layout="topleft"
       left="226" top="213" width="280" height="16">
          replies to any one person
      </text>

      <text type="string" follows="left|top" layout="topleft"
       left="20" top="242" width="120" height="16">
          Also answer to
      </text>

      <line_editor control_name="LumenAIAutoRespondNames" follows="left|top" layout="topleft"
       left="130" top="239" width="260" height="20"
       name="auto_respond_names" max_length_bytes="255" />

      <text type="string" follows="left|top" layout="topleft"
       left="20" top="266" width="480" height="26" word_wrap="true">
          Nicknames people use for you in chat, separated by commas. Needed when your display name is not what anyone types.
      </text>

    </panel>

  </tab_container>

</panel>
