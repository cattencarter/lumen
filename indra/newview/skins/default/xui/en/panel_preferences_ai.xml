<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel
 border="true"
 follows="all"
 height="480"
 layout="topleft"
 left="1"
 top="1"
 width="540"
 label="AI"
 name="ai">

    <!-- Positions are explicit rather than stacked padding: this panel cannot
         grow past 480, because the preferences tab container fixes its size,
         and a panel that overflows simply loses its last controls with no
         error anywhere.

         Each provider owns a block: its key, then the model to use with it.
         The model combo allows typed entry, because model names change far
         faster than a viewer release and the list will go stale. A value that
         is not in the list is added to it at runtime by the panel code, since
         LLComboBox::setValue silently declines to display one it cannot find. -->

    <text type="string" follows="left|top" layout="topleft"
     left="30" top="14" width="480" height="16" font="SansSerifBold">
        AI provider keys
    </text>

    <text type="string" follows="left|top" layout="topleft"
     left="30" top="34" width="480" height="26" word_wrap="true">
        You only need a key for the provider you want to use. Get one from that provider's own website.
    </text>

    <!-- Anthropic -->

    <text type="string" follows="left|top" layout="topleft"
     left="30" top="66" width="480" height="14" font="SansSerifBold">
        Anthropic
    </text>

    <line_editor follows="left|top" layout="topleft"
     left="30" top="84" width="330" height="22"
     name="key_anthropic" is_password="true"
     select_on_focus="true" commit_on_focus_lost="false"
     max_length_bytes="400" />

    <button follows="left|top" layout="topleft"
     left="368" top="84" width="70" height="22"
     label="Clear" name="clear_anthropic" />

    <text type="string" follows="left|top" layout="topleft"
     left="30" top="110" width="480" height="26" word_wrap="true"
     name="status_anthropic">
        No key saved.
    </text>

    <text type="string" follows="left|top" layout="topleft"
     left="30" top="142" width="52" height="16">
        Model
    </text>

    <combo_box control_name="LumenAIAnthropicModel" follows="left|top" layout="topleft"
     left="86" top="138" width="274" height="22"
     name="model_anthropic" allow_text_entry="true" max_chars="80">
        <combo_box.item label="claude-opus-5 (most capable)"   name="o5" value="claude-opus-5" />
        <combo_box.item label="claude-sonnet-5 (balanced)"     name="s5" value="claude-sonnet-5" />
        <combo_box.item label="claude-haiku-4-5 (fastest)"     name="h45" value="claude-haiku-4-5-20251001" />
    </combo_box>

    <!-- OpenAI -->

    <text type="string" follows="left|top" layout="topleft"
     left="30" top="172" width="480" height="14" font="SansSerifBold">
        OpenAI
    </text>

    <line_editor follows="left|top" layout="topleft"
     left="30" top="190" width="330" height="22"
     name="key_openai" is_password="true"
     select_on_focus="true" commit_on_focus_lost="false"
     max_length_bytes="400" />

    <button follows="left|top" layout="topleft"
     left="368" top="190" width="70" height="22"
     label="Clear" name="clear_openai" />

    <text type="string" follows="left|top" layout="topleft"
     left="30" top="216" width="480" height="26" word_wrap="true"
     name="status_openai">
        No key saved.
    </text>

    <text type="string" follows="left|top" layout="topleft"
     left="30" top="248" width="52" height="16">
        Model
    </text>

    <combo_box control_name="LumenAIOpenAIModel" follows="left|top" layout="topleft"
     left="86" top="244" width="274" height="22"
     name="model_openai" allow_text_entry="true" max_chars="80">
        <combo_box.item label="gpt-4o"      name="g4o"  value="gpt-4o" />
        <combo_box.item label="gpt-4o-mini" name="g4om" value="gpt-4o-mini" />
    </combo_box>

    <!-- Which of the two the Assistant window talks to -->

    <text type="string" follows="left|top" layout="topleft"
     left="30" top="280" width="480" height="14" font="SansSerifBold">
        Use
    </text>

    <combo_box control_name="LumenAIProvider" follows="left|top" layout="topleft"
     left="30" top="298" width="180" height="22" name="provider">
        <combo_box.item label="Anthropic" name="anthropic" value="anthropic" />
        <combo_box.item label="OpenAI"    name="openai"    value="openai" />
    </combo_box>

    <text type="string" follows="left|top" layout="topleft"
     left="30" top="326" width="480" height="26" word_wrap="true">
        You can type a model name that is not in the list. The lists are a starting point, not a limit.
    </text>

    <button follows="left|top" layout="topleft"
     left="368" top="296" width="140" height="22"
     label="Memory..." name="memory_btn" />

    <text type="string" follows="left|top" layout="topleft"
     left="30" top="358" width="480" height="58" word_wrap="true">
        A key is stored the way Lumen stores your Second Life password: scrambled and tied to this computer, so it will not work if copied elsewhere and never sits in settings.xml where it could be attached to a bug report. That is not strong encryption. Treat a key here as you would a saved password.
    </text>

    <text type="string" follows="left|top" layout="topleft"
     left="30" top="422" width="480" height="30" word_wrap="true">
        Saved keys are shown only as their first and last few characters. To replace one, type the new key over it. Nothing is written until you click OK.
    </text>

</panel>
