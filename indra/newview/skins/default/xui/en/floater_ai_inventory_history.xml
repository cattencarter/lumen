<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- <Lumen> What the assistant changed in the inventory, and how it was arranged before. -->
<floater
 legacy_header_height="18"
 can_minimize="true"
 can_close="true"
 can_resize="true"
 height="560"
 min_height="440"
 min_width="480"
 layout="topleft"
 name="floater_ai_inventory_history"
 help_topic="floater_ai_inventory_history"
 save_rect="true"
 single_instance="true"
 title="Assistant Inventory History"
 width="600">

    <text type="string" follows="left|top|right" layout="topleft"
     left="12" top="24" width="576" height="16" name="sets_label">
        What the assistant changed, newest first
    </text>
    <scroll_list
     follows="left|top|right" layout="topleft"
     left="12" top="42" width="576" height="150"
     column_padding="0" draw_heading="true" multi_select="false"
     name="change_sets">
        <scroll_list.columns label="When" name="when" width="110" />
        <scroll_list.columns label="What was asked" name="asked" relative_width="0.62" />
        <scroll_list.columns label="Changes" name="what" relative_width="0.38" />
    </scroll_list>
    <button follows="left|top" layout="topleft"
     left="12" top="198" width="120" height="22"
     label="Undo this" name="undo_btn"
     tool_tip="Put back what this request changed. Anything changed again since is left alone." />

    <text type="string" follows="left|top|right" layout="topleft"
     left="12" top="232" width="576" height="16" name="snaps_label">
        Snapshots of how the inventory was arranged
    </text>
    <scroll_list
     follows="left|top|right" layout="topleft"
     left="12" top="250" width="576" height="100"
     column_padding="0" draw_heading="true" multi_select="false"
     name="snapshots">
        <scroll_list.columns label="When" name="when" width="110" />
        <scroll_list.columns label="Taken" name="reason" relative_width="0.80" />
        <scroll_list.columns label="Items" name="size" relative_width="0.20" />
    </scroll_list>
    <button follows="left|top" layout="topleft"
     left="12" top="356" width="180" height="22"
     label="Show what would change" name="preview_btn" />
    <button follows="left|top" layout="topleft"
     left="200" top="356" width="120" height="22"
     label="Restore..." name="restore_btn"
     tool_tip="Put folders and items back where this snapshot has them, and their names back." />

    <text_editor
     follows="all" layout="topleft"
     left="12" top="386" width="576" height="138"
     enabled="false" word_wrap="true" max_length="65536"
     name="detail">Choose a change and Undo it, or choose a snapshot to see what restoring it would change.</text_editor>

    <text type="string" follows="left|bottom|right" layout="topleft"
     left="12" top="530" width="576" height="24" word_wrap="true" name="limits">
        Kept on this computer only. Anything emptied from the Trash, given away or rezzed cannot be brought back.
    </text>
</floater>
