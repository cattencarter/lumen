<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_login">
	<layout_stack name="login_widgets">
		<layout_panel name="login">
			<text name="log_in_text">CONNEXION</text>
			<text name="username_text">Nom d'utilisateur :</text>
			<button tool_tip="Supprimer ce nom d'utilisateur" name="remove_user_btn"/>
			<combo_box tool_tip="Le nom d'utilisateur que vous avez choisi à l'inscription, comme bobsmith420 ou Steller Sunshine" name="username_combo"/>
			<text name="password_text">Mot de passe :</text>
		</layout_panel>
		<layout_panel name="start_location_panel">
			<text name="start_location_text">Démarrer :</text>
			<combo_box name="start_location_combo">
				<combo_box.item label="Dernier emplacement" name="MyLastLocation"/>
				<combo_box.item label="Domicile" name="MyHome"/>
				<combo_box.item label="&lt;Saisissez le nom de la région&gt;" name="Typeregionname"/>
			</combo_box>
		</layout_panel>
		<layout_panel name="grid_panel">
			<text name="grid_builder_text">
				+ Ajouter des grilles
			</text>
			<text name="grid_login_text">Connexion à la Grille :</text>
		</layout_panel>
		<layout_panel name="links_login_panel">
			<text name="create_new_account_text">S'enregistrer</text>
			<text name="forgot_password_text">Mot de passe/Nom d'utilisateur oublié ?</text>
			<button label="Connexion" name="connect_btn"/>
			<check_box label="Enr. le nom" name="remember_username_check"/>
			<check_box label="Enr. le mot de passe" name="remember_check"/>
			<button name="password_show_btn" tool_tip="Afficher le mot de passe"/>
			<button name="password_hide_btn" tool_tip="Masquer le mot de passe"/>
		</layout_panel>
  <!-- <Lumen> The Mode picker is gone from the English panel, so this
       translation of it could never render   a localised file can CHANGE a
       node the base declares, never ADD one. Removed anyway rather than
       left inert: it named settings_firestorm.xml, a file that no longer
       exists, in a viewer that no longer has modes. -->
	</layout_stack>
</panel>
