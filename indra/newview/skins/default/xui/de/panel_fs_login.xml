<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_login">
	<panel.string name="create_account_url">
		http://de.secondlife.com/registration/
	</panel.string>
	<panel.string name="forgot_password_url">
		http://secondlife.com/account/request.php?lang=de
	</panel.string>
	<string name="ServerComboTooltip">
		Ein bekanntes Grid oder eine Grid-URI
	</string>
	<layout_stack name="login_widgets">
		<layout_panel name="login">
			<text name="log_in_text">
				ANMELDEN
			</text>
			<text name="username_text">
				Benutzername:
			</text>
			<combo_box name="username_combo" tool_tip="Bei der Registrierung gewählter Benutzername wie „berndschmidt12“ oder „Liebe Sonne“"/>
			<button tool_tip="Diesen Benutzernamen löschen" name="remove_user_btn"/>
			<text name="password_text">
				Kennwort:
			</text>
		</layout_panel>
		<layout_panel name="start_location_panel">
			<text name="start_location_text">
				Hier starten:
			</text>
			<combo_box name="start_location_combo">
				<combo_box.item label="Letzter Standort" name="MyLastLocation"/>
				<combo_box.item label="Zuhause" name="MyHome"/>
				<combo_box.item label="&lt;Region eingeben&gt;" name="Typeregionname"/>
			</combo_box>
		</layout_panel>
		<layout_panel name="grid_panel">
			<text name="grid_builder_text">
				+ Klicken um Grids hinzuzufügen
			</text>
			<text name="grid_login_text">
				Gridauswahl:
			</text>
		</layout_panel>
		<layout_panel name="links_login_panel">
			<text name="create_new_account_text">
				Registrieren
			</text>
			<text name="forgot_password_text">
				Benutzernamen oder Kennwort vergessen?
			</text>
			<button label="Anmelden" name="connect_btn"/>
			<check_box label="Benutzername speichern" name="remember_username_check"/>
			<check_box label="Kennwort speichern" name="remember_check"/>
			<button name="password_show_btn" tool_tip="Passwort anzeigen"/>
			<button name="password_hide_btn" tool_tip="Passwort verstecken"/>
		</layout_panel>
  <!-- <Lumen> The Mode picker is gone from the English panel, so this
       translation of it could never render   a localised file can CHANGE a
       node the base declares, never ADD one. Removed anyway rather than
       left inert: it named settings_firestorm.xml, a file that no longer
       exists, in a viewer that no longer has modes. -->
	</layout_stack>
</panel>
