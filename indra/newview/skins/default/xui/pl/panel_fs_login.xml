<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_login">
	<string name="ServerComboTooltip">
		Istniejący świat lub URI świata
	</string>
	<layout_stack name="login_widgets">
		<layout_panel name="login">
			<text name="log_in_text">
				ZALOGUJ SIĘ
			</text>
			<text name="username_text">
				Użytkownik:
			</text>
			<button tool_tip="Usuń tą nazwę użytkownika" name="remove_user_btn"/>
			<combo_box name="username_combo" tool_tip="Nazwa użytkownika wybrana przy rejestracji, np. bobsmith12 lub Steller Sunshine"/>
			<text name="password_text">
				Hasło:
			</text>
		</layout_panel>
		<layout_panel name="start_location_panel">
			<text name="start_location_text">
				Rozpocznij w:
			</text>
			<combo_box name="start_location_combo">
				<combo_box.item label="Ostatnia lokalizacja" name="MyLastLocation"/>
				<combo_box.item label="Moje Miejsce Startu" name="MyHome"/>
				<combo_box.item label="&lt;Wpisz nazwę regionu&gt;" name="Typeregionname"/>
			</combo_box>
		</layout_panel>
		<layout_panel name="grid_panel">
			<text name="grid_builder_text">
				+ Kliknij, by dodać światy
			</text>
			<text name="grid_login_text">
				Loguj do świata:
			</text>
		</layout_panel>
		<layout_panel name="links_login_panel">
			<text name="create_new_account_text">
				Utwórz nowe konto
			</text>
			<text name="forgot_password_text">
				Zapomniałeś/aś nazwy lub hasła?
			</text>
			<button label="Zaloguj" name="connect_btn"/>
			<check_box label="Zapamiętaj login" name="remember_username_check"/>
			<check_box label="Zapamiętaj hasło" name="remember_check"/>
			<button name="password_show_btn" tool_tip="Pokaż hasło" />
			<button name="password_hide_btn" tool_tip="Ukryj hasło" />
		</layout_panel>
  <!-- <FS:AICtl> The Mode picker is gone from the English panel, so this
       translation of it could never render   a localised file can CHANGE a
       node the base declares, never ADD one. Removed anyway rather than
       left inert: it named settings_firestorm.xml, a file that no longer
       exists, in a viewer that no longer has modes. -->
	</layout_stack>
</panel>
